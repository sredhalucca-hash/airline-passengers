      "source": [
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.optim as optim\n",
        "import numpy as np\n"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# 1. Synthetic Data Generation (y = 2x + 3)\n",
        "X = np.random.rand(100, 1).astype(np.float32)\n",
        "y = 2 * X + 3 + np.random.randn(100, 1).astype(np.float32) * 0.1\n",
        "\n",
        "X_tensor = torch.from_numpy(X)\n",
        "y_tensor = torch.from_numpy(y)"
      ],
      "metadata": {
        "id": "SIYfihn5L2Np"
      },
      "execution_count": 3,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# 2. Linear Regression Model\n",
        "model = nn.Linear(1, 1)"
      ],
      "metadata": {
        "id": "xsOMEuXHMAbo"
      },
      "execution_count": 4,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# 3. Loss and Optimizer\n",
        "criterion = nn.MSELoss()\n",
        "optimizer = optim.SGD(model.parameters(), lr=0.1)"
      ],
      "metadata": {
        "id": "1MU31rXHMGIg"
      },
      "execution_count": 5,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# 4. Training Loop\n",
        "for epoch in range(100):\n",
        "    outputs = model(X_tensor)\n",
        "    loss = criterion(outputs, y_tensor)\n",
        "\n",
        "    optimizer.zero_grad()\n",
        "    loss.backward()\n",
        "    optimizer.step()\n",
        "\n",
        "    if (epoch+1) % 20 == 0:\n",
        "        print(f\"Epoch [{epoch+1}/100], Loss: {loss.item():.4f}\")\n",
        "\n",
        "print(f\"Trained Weight: {model.weight.item():.4f}, Bias: {model.bias.item():.4f}\")"
      ],
